<resources>
    <style name="Theme.FocusBlack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>

        <!-- Background/Surface -->
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>

        <!-- Error colors -->
        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/black</item>

        <!-- Bottom Navigation -->
        <item name="bottomNavigationStyle">@style/Widget.FocusBlack.BottomNavigation</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.FocusBlack.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/black</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Preferences Theme -->
    <style name="Theme.FocusBlack.Settings" parent="Theme.FocusBlack">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.FocusBlack</item>
    </style>

    <style name="PreferenceThemeOverlay.FocusBlack" parent="PreferenceThemeOverlay.v14.Material">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/md_theme_dark_onSurfaceVariant</item>
    </style>
</resources>
